{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miao",
  "identifier": "io.github.yuxiangluo.miao",
  "build": {
    "frontendDist": "panel-placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "开箱即用的透明代理",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
