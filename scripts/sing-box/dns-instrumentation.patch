+type miaoCaptureLogger struct {
+	logger.ContextLogger
+	access sync.Mutex
+	lines  []string
+}
+
+func (l *miaoCaptureLogger) InfoContext(_ context.Context, args ...any) {
+	l.access.Lock()
+	defer l.access.Unlock()
+	l.lines = append(l.lines, args[0].(string)+args[1].(string))
+}
+
+func (l *miaoCaptureLogger) WarnContext(context.Context, ...any) {}
+
+func TestMiaoDNSCompletionSchema(t *testing.T) {
+	started := time.Now().Add(-time.Millisecond)
+	tests := []struct {
+		name     string
+		response *mDNS.Msg
+		err      error
+		outcome  string
+		rcode    *int
+	}{
+		{name: "success", response: &mDNS.Msg{}, outcome: "success", rcode: intPtr(0)},
+		{name: "dns-error-response", response: &mDNS.Msg{MsgHdr: mDNS.MsgHdr{Rcode: mDNS.RcodeNameError}}, outcome: "dns_error", rcode: intPtr(mDNS.RcodeNameError)},
+		{name: "error", err: errors.New("bad \"resolver\"\nline"), outcome: "error"},
+		{name: "typed-rcode-error", err: RcodeError(mDNS.RcodeRefused), outcome: "dns_error", rcode: intPtr(mDNS.RcodeRefused)},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			event := newMiaoDNSCompletion(started, "quote\".example", "A", test.response, test.err)
+			if event.Outcome != test.outcome || event.DurationMS < 0 || !equalIntPtr(event.Rcode, test.rcode) {
+				t.Fatalf("unexpected event: %+v", event)
+			}
+			encoded, err := json.Marshal(event)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(string(encoded), "\nline") || !strings.Contains(string(encoded), `quote\".example`) {
+				t.Fatalf("JSON fields were not escaped: %s", encoded)
+			}
+		})
+	}
+}
+
+func TestMiaoDNSQuestion(t *testing.T) {
+	if domain, queryType := miaoDNSQuestion(nil); domain != "" || queryType != "UNKNOWN" {
+		t.Fatalf("nil query: %q %q", domain, queryType)
+	}
+	message := &mDNS.Msg{Question: []mDNS.Question{{Name: "example.com.", Qtype: mDNS.TypeAAAA}}}
+	if domain, queryType := miaoDNSQuestion(message); domain != "example.com" || queryType != "AAAA" {
+		t.Fatalf("valid query: %q %q", domain, queryType)
+	}
+}
+
+func TestMiaoDNSAsyncEarlyCompletion(t *testing.T) {
+	log := new(miaoCaptureLogger)
+	router := &Router{logger: log}
+	message := &mDNS.Msg{}
+	callbacks := 0
+	router.ExchangeAsync(context.Background(), message, adapter.DNSQueryOptions{}, func(response *mDNS.Msg, err error) {
+		callbacks++
+		if response == nil || response.Rcode != mDNS.RcodeFormatError || err != nil {
+			t.Fatalf("unexpected early response: %v, %v", response, err)
+		}
+	})
+	if callbacks != 1 || len(log.lines) != 1 || !strings.HasPrefix(log.lines[0], "MIAO_DNS ") {
+		t.Fatalf("completion count: callbacks=%d logs=%q", callbacks, log.lines)
+	}
+	var event miaoDNSCompletion
+	if err := json.Unmarshal([]byte(strings.TrimPrefix(log.lines[0], "MIAO_DNS ")), &event); err != nil {
+		t.Fatal(err)
+	}
+	if event.QueryType != "UNKNOWN" || event.Outcome != "dns_error" || event.Rcode == nil || *event.Rcode != mDNS.RcodeFormatError {
+		t.Fatalf("unexpected completion: %+v", event)
+	}
+}
+
+func TestMiaoDNSLookupCompletion(t *testing.T) {
+	log := new(miaoCaptureLogger)
+	router := &Router{logger: log, closing: true}
+	_, err := router.Lookup(context.Background(), "escape\".example", adapter.DNSQueryOptions{})
+	if err == nil || len(log.lines) != 1 || !strings.Contains(log.lines[0], `"query_type":"LOOKUP"`) || !strings.Contains(log.lines[0], `escape\".example`) {
+		t.Fatalf("lookup completion: err=%v logs=%q", err, log.lines)
+	}
+}
+
+func intPtr(value int) *int { return &value }
+
+func equalIntPtr(left, right *int) bool {
+	return left == nil && right == nil || left != nil && right != nil && *left == *right
+}
