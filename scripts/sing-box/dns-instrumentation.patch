+type miaoDNSCompletion struct {
+	Version    int     `json:"v"`
+	Domain     string  `json:"domain"`
+	QueryType  string  `json:"query_type"`
+	DurationMS float64 `json:"duration_ms"`
+	Outcome    string  `json:"outcome"`
+	Rcode      *int    `json:"rcode"`
+	Error      *string `json:"error"`
+	Transport  *string `json:"transport"`
+}
+
+func (r *Router) logMiaoDNSCompletion(ctx context.Context, started time.Time, domain string, queryType string, response *mDNS.Msg, err error, transport adapter.DNSTransport) {
+	event := newMiaoDNSCompletion(started, domain, queryType, response, err)
+	if transport != nil {
+		transportTag := transport.Tag()
+		event.Transport = &transportTag
+	}
+	encoded, marshalErr := json.Marshal(event)
+	if marshalErr != nil {
+		return
+	}
+	r.logger.InfoContext(ctx, "MIAO_DNS ", string(encoded))
+}
+
+func newMiaoDNSCompletion(started time.Time, domain string, queryType string, response *mDNS.Msg, err error) miaoDNSCompletion {
+	event := miaoDNSCompletion{Version: 1, Domain: domain, QueryType: queryType, DurationMS: float64(time.Since(started)) / float64(time.Millisecond), Outcome: "success"}
+	if response != nil {
+		rcode := response.Rcode
+		event.Rcode = &rcode
+		if rcode != mDNS.RcodeSuccess {
+			event.Outcome = "dns_error"
+		}
+	}
+	if err != nil {
+		event.Outcome = "error"
+		errorMessage := err.Error()
+		event.Error = &errorMessage
+		var rcodeError RcodeError
+		if errors.As(err, &rcodeError) {
+			rcode := int(rcodeError)
+			event.Rcode = &rcode
+			event.Outcome = "dns_error"
+		}
+	}
+	return event
+}
+
+func miaoDNSQuestion(message *mDNS.Msg) (string, string) {
+	if message == nil || len(message.Question) != 1 {
+		return "", "UNKNOWN"
+	}
+	question := message.Question[0]
+	queryType, loaded := mDNS.TypeToString[question.Qtype]
+	if !loaded {
+		queryType = F.ToString(question.Qtype)
+	}
+	return FqdnToDomain(question.Name), queryType
+}
